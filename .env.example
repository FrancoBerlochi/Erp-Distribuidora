# ==============================================================================
# VARIABLES DE ENTORNO OBLIGATORIAS - SUPABASE
# ==============================================================================
# Obtén estas credenciales en: https://app.supabase.com -> Tu Proyecto -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# ==============================================================================
# CONFIGURACIÓN OPCIONAL DEL SISTEMA ERP
# ==============================================================================
# Plan contratado: 'enterprise', 'profesional', 'basico'
NEXT_PUBLIC_ERP_PLAN=enterprise

# Módulos habilitados separados por coma (ej: ecommerce,pos,inventory,reports,suppliers,batches)
NEXT_PUBLIC_ERP_ACTIVE_MODULES=ecommerce,pos,inventory,reports,suppliers,batches
